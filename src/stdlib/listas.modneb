# Utilidades de listas escritas em Nebula.

função somar usando (itens)
  declarar total = 0
  para cada item em itens faça
    total += item
  fim
  retornar total
fim

função maior usando (itens)
  declarar atual = itens[0]
  para cada item em itens faça
    se item > atual então atual = item
  fim
  retornar atual
fim

função menor usando (itens)
  declarar atual = itens[0]
  para cada item em itens faça
    se item < atual então atual = item
  fim
  retornar atual
fim

função inverter_lista usando (itens)
  declarar resultado = []
  declarar i = len(itens) - 1
  enquanto i >= 0 faça
    resultado += itens[i]
    i -= 1
  fim
  retornar resultado
fim
