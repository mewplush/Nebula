classe Animal
    função principal usando (esse, nome)
        esse.nome = nome
    fim
    função falar_nome usando ()
        falar("x")
    fim
    função mostrar usando (esse)
        falar(esse.nome)
        falar(esse.idade)
    fim
fim

classe Gato extende Animal
    função miar usando (esse)
        retornar super.nada()
    fim
fim
classe Orfao extende Inexistente
fim
classe Solto
    função f usando (esse)
        retornar super.f()
    fim
fim

